rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // ---- Helpers ----
    function signedIn() { return request.auth != null; }

    function isAdmin() {
      return signedIn()
        && exists(/databases/$(database)/documents/users/$(request.auth.uid))
        && get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'admin';
    }

    // Perfil de usuario. Cada quien lee solo el suyo. Al crearse queda como
    // 'visitor' obligatoriamente; el rol 'admin' solo lo puede poner otro admin
    // (o vos manualmente desde la consola de Firebase para el primer admin).
    match /users/{uid} {
      allow read:   if signedIn() && request.auth.uid == uid;
      allow create: if signedIn() && request.auth.uid == uid
                    && request.resource.data.role == 'visitor'
                    && request.resource.data.keys().hasOnly(['email', 'role']);
      allow update, delete: if isAdmin();
    }

    // Contenido del torneo: lectura pública (visitantes no necesitan login),
    // escritura únicamente para administradores.
    match /tournaments/{id} { allow read: if true; allow write: if isAdmin(); }
    match /teams/{id}       { allow read: if true; allow write: if isAdmin(); }
    match /players/{id}     { allow read: if true; allow write: if isAdmin(); }
    match /settings/{id}    { allow read: if true; allow write: if isAdmin(); }
    match /news/{id}        { allow read: if true; allow write: if isAdmin(); }

    match /matches/{id} {
      allow read:  if true;
      allow write: if isAdmin();

      match /stats/{playerId} {
        allow read:  if true;
        allow write: if isAdmin();
      }
    }

    // Tokens de notificaciones. Cada dispositivo registra el suyo (sin necesidad
    // de login, para que los visitantes también reciban avisos). Nadie puede
    // leerlos desde el cliente: solo el servidor (Admin SDK) los usa para enviar.
    match /fcmTokens/{token} {
      allow read:   if false;
      allow create: if request.resource.data.keys().hasOnly(['token', 'uid', 'userAgent', 'createdAt']);
      allow update: if request.resource.data.keys().hasOnly(['token', 'uid', 'userAgent', 'createdAt']);
      allow delete: if isAdmin();
    }

    // Cualquier otra ruta no contemplada queda bloqueada por defecto.
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
